# =============================================================================
# CGTK Backend — environment template
# Copy to `.dev.vars` for local Wrangler development. NEVER commit the real file.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Service role key. Grants unrestricted access to every table, bypassing RLS.
# Server-side only — this must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anon key. Safe to expose; used only to verify participant JWTs.
SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Database (migrations only)
# -----------------------------------------------------------------------------
# Use the DIRECT connection (port 5432) — pg_dump and DDL need a real session.
# Supabase Dashboard > Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# The application itself never opens TCP connections: it talks to Supabase over
# HTTP (PostgREST), so the transaction pooler is not needed at runtime. If you
# ever move the API to a Node host, switch it to port 6543 (?pgbouncer=true).

# -----------------------------------------------------------------------------
# QR Identity
# -----------------------------------------------------------------------------
# HMAC secret for signing QR payloads. Lets field scanners reject forged codes
# while offline. Generate with:  openssl rand -hex 32
QR_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,https://cgtk.my.id
