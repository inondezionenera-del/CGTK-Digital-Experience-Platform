{
  "name": "cgtk-backend",
  "version": "1.0.0",
  "description": "Backend API for the CGTK 2027 Digital Experience Platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "node scripts/migrate.mjs",
    "db:reset": "node scripts/migrate.mjs --reset",
    "db:seed": "node scripts/migrate.mjs --seed-only"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "postgres": "^3.4.4",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.78.0"
  }
}
