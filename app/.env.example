# Salin jadi .env waktu menjalankan di laptop.
# Di Vercel, isi ini sebagai Environment Variables di dasbor, bukan berkas.
#
# Minta kedua nilai ini ke Rafly. Jangan pernah commit berkas .env.

# User cgtk_kuis, PORT 6543 (Connection Pooler), bukan 5432.
DATABASE_URL=

# Kunci bersama dengan Worker untuk memeriksa tanda tangan identitas.
# Kalau kosong, layanan menolak semua permintaan, bukan melayani tanpa periksa.
CGTK_SECRET=
