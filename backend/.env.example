# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
APP_DEBUG=true

# PostgreSQL connection (relational, transaction-oriented DB — settled Phase 2 constraint)
DATABASE_URL=postgresql+psycopg://cgtk:cgtk@localhost:5432/cgtk

# Comma-separated list of allowed CORS origins (frontend origins, e.g. https://cgtk.example.com)
CORS_ORIGINS=http://localhost:3000

# Registration Code secondary-factor lookup rate limit (OD-3 SETTLED: required; exact numbers configurable)
REGISTRATION_LOOKUP_RATE_LIMIT_PER_MINUTE=5

# Payment gateway adapter selection (OD-4 OPEN — "mock" is the only implemented adapter for now)
PAYMENT_GATEWAY_ADAPTER=mock

# Webhook signing secret for the selected gateway adapter (OD-4 OPEN — placeholder for mock adapter)
PAYMENT_GATEWAY_WEBHOOK_SECRET=change-me-in-real-deployment
